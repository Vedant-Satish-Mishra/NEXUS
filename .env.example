# ==============================================================================
# NEXUS Environment Configuration Template (.env.example)
# Copy to .env and fill in real values. NEVER commit real secrets to Git.
# ==============================================================================

# Application Environment (dev | prod | test)
ENV=dev
DEBUG=true

# Security & Authentication
# Generate a secure secret using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Local Model & Ollama
# When running backend in Docker, use http://host.docker.internal:11434
# When running backend on host, use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROFILE=fast

# Database (PostgreSQL)
# AsyncPG format for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://nexus:nexus_password@localhost:5432/nexus
# Psycopg format for LangGraph checkpointer
CHECKPOINT_DSN=postgresql://nexus:nexus_password@localhost:5432/nexus

# Vector Database (ChromaDB)
CHROMA_PATH=./data/chroma

# Document Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
MAX_USER_QUOTA_MB=500

# Sandbox Shared Secret
SANDBOX_KEY=replace_with_sandbox_shared_secret
SANDBOX_URL=http://localhost:8001

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
