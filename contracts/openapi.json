{
  "openapi": "3.1.0",
  "info": {
    "title": "NEXUS AI Cognitive System API",
    "description": "API and SSE event streaming contracts for local-first multi-agent cognitive assistant.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Create Run",
        "description": "Start a cognitive run.",
        "operationId": "create_run_api_v1_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Create Run Api V1 Runs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Run",
        "description": "Get run state and pending action.",
        "operationId": "get_run_api_v1_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Run Api V1 Runs  Run Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/plan": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Decide Plan",
        "description": "Submit approval, edit, or re-plan decision.",
        "operationId": "decide_plan_api_v1_runs__run_id__plan_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Decide Plan Api V1 Runs  Run Id  Plan Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}/agents": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Get Agent Config",
        "operationId": "get_agent_config_api_v1_conversations__conversation_id__agents_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "agents"
        ],
        "summary": "Update Agent Config",
        "operationId": "update_agent_config_api_v1_conversations__conversation_id__agents_put",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentConfig": {
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "full",
              "custom"
            ],
            "title": "Preset",
            "default": "balanced"
          },
          "enabled_agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enabled Agents",
            "description": "Active agent list. Controller and reasoning are strictly enforced."
          },
          "auto_approve_plans": {
            "type": "boolean",
            "title": "Auto Approve Plans",
            "description": "Skip plan approval wait",
            "default": false
          },
          "model_profile": {
            "type": "string",
            "enum": [
              "fast",
              "quality"
            ],
            "title": "Model Profile",
            "description": "Qwen3 4B vs 8B Q4",
            "default": "fast"
          }
        },
        "type": "object",
        "title": "AgentConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanDecision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "replan"
            ],
            "title": "Action",
            "description": "User's decision on the plan"
          },
          "steps": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PlanStep"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps",
            "description": "User-modified steps when action='edit'"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback",
            "description": "Critique or guidance when action='replan'"
          },
          "auto_approve_future": {
            "type": "boolean",
            "title": "Auto Approve Future",
            "description": "Whether to auto-approve subsequent plans in this chat",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "PlanDecision"
      },
      "PlanStep": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique step ID (e.g. step_1)"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Concise step title"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Detailed instructions, milestones, or timeline"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Depends On",
            "description": "IDs of prerequisite steps"
          },
          "needs_retrieval": {
            "type": "boolean",
            "title": "Needs Retrieval",
            "description": "Whether this step requires retrieval",
            "default": true
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool",
            "description": "Optional tool assigned to this step"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "detail"
        ],
        "title": "PlanStep"
      },
      "RunCreate": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id",
            "description": "Target conversation ID"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "User prompt text"
          },
          "file_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "File Ids",
            "description": "IDs of uploaded files attached to this run"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "message"
        ],
        "title": "RunCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}